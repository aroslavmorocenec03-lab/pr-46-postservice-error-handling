@baseUrl = http://localhost:5211

### GET: список — 200
GET {{baseUrl}}/postings

### GET: відсутній запис — 404
GET {{baseUrl}}/postings/999999

### POST: некоректні дані — 400 з errors
POST {{baseUrl}}/postings
Content-Type: application/json

{"from":"","to":"","content":"","deliveryType":0,"weight":0,"width":0,"height":0,"depth":0,"value":-1,"price":-1}

### PUT: відсутній запис — 404
PUT {{baseUrl}}/postings/999999
Content-Type: application/json

{"id":999999,"from":"A","to":"B","content":"Books","deliveryType":0,"weight":1,"width":10,"height":10,"depth":10,"value":100,"price":80}

### DELETE: відсутній запис — 404
DELETE {{baseUrl}}/postings/999999

### Увімкнути навчальний виняток — доступно лише з --demo-faults
POST {{baseUrl}}/__demo/fault/500

### GET: виняток у серверному ендпойнті — 500
GET {{baseUrl}}/postings

### Вимкнути навчальний виняток
POST {{baseUrl}}/__demo/fault/none

### GET: сервер відновився — 200
GET {{baseUrl}}/postings
